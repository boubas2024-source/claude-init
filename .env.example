# ─── Base de données ──────────────────────────────────────────────────────────
POSTGRES_DB=imaz_db
POSTGRES_USER=imaz_user
POSTGRES_PASSWORD=changeme_strong_password

DATABASE_URL="postgresql://imaz_user:changeme_strong_password@localhost:5432/imaz_db"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password
REDIS_URL="redis://:changeme_redis_password@localhost:6379"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 64
JWT_SECRET="changeme_jwt_secret_at_least_32_chars_long"
NEXTAUTH_SECRET="changeme_nextauth_secret_at_least_32_chars"
NEXTAUTH_URL="https://imaz.bf"

# ─── Email (SMTP / SendGrid) ──────────────────────────────────────────────────
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your_sendgrid_api_key"
EMAIL_FROM="IMAZ — GIE HORONYA <noreply@imaz.bf>"

# ─── Fichiers uploadés ────────────────────────────────────────────────────────
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"

# ─── SMS (Faso SMS) ───────────────────────────────────────────────────────────
FASO_SMS_API_KEY="your_fasosms_api_key"
FASO_SMS_SENDER="IMAZ"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://imaz.bf"
NEXT_PUBLIC_APP_NAME="IMAZ — L'Immobilier de A à Z"
