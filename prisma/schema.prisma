generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategorieEnum {
  DJIGUI
  DJIGUIYA
  HAKILI
  HAKILI_SIGUI
}

enum StatutProduit {
  DISPONIBLE
  RESERVE
  VENDU
}

enum StatutProgramme {
  OUVERT
  FERME
  EN_COURS
}

enum StatutSouscription {
  EN_ATTENTE
  VALIDEE
  EXPIREE
  ANNULEE
}

enum ModeReglement {
  ESPECES
  CHEQUE
  VIREMENT
  ORANGE_MONEY
  MOOV_MONEY
}

enum RoleBO {
  SUPER_ADMIN
  RESPONSABLE_PROGRAMME
  AGENT_ACCUEIL
}

enum StatutClient {
  ACTIF
  INACTIF
  SUSPENDU
}

enum StatutUtilisateur {
  ACTIF
  INACTIF
}

enum TypeNotification {
  SOUSCRIPTION_CONFIRMEE
  PAIEMENT_RECU
  DOSSIER_EXPIRE
  RAPPEL_PAIEMENT
  MESSAGE_GENERAL
}

enum CanalNotification {
  EMAIL
  SMS
  IN_APP
}

enum StatutEnvoi {
  EN_ATTENTE
  ENVOYE
  ECHEC
}

model Client {
  id                  String        @id @default(cuid())
  nom                 String
  prenom              String
  dateNaissance       DateTime?
  lieuNaissance       String?
  nationalite         String        @default("Burkinabè")
  numIdentite         String?       @unique
  telephone           String        @unique
  telephoneSecondaire String?
  email               String        @unique
  adresse             String?
  secteur             String?
  ville               String?
  province            String?
  profession          String?
  sourceFinancement   String?
  pieceJointe         String?
  photo               String?
  motDePasse          String
  statut              StatutClient  @default(ACTIF)
  dateCreation        DateTime      @default(now())
  otpVerified         Boolean       @default(false)

  souscriptions Souscription[]

  @@map("clients")
}

model Programme {
  id            String          @id @default(cuid())
  nom           String
  description   String?
  ville         String
  secteur       String?
  zone          String?
  dateOuverture DateTime?
  dateCloture   DateTime?
  statut        StatutProgramme @default(EN_COURS)
  imageUrl      String?

  produits      Produit[]
  souscriptions Souscription[]

  @@map("programmes")
}

model Produit {
  id                 String        @id @default(cuid())
  programmeId        String
  programme          Programme     @relation(fields: [programmeId], references: [id])
  categorie          CategorieEnum
  reference          String        @unique
  surface            Float
  niveaux            Int           @default(1)
  nbPieces           Int
  description        String?
  localisation       String?
  prixTotal          Float
  fraisSouscription  Float
  stockTotal         Int
  stockDisponible    Int
  statut             StatutProduit @default(DISPONIBLE)
  galerie            Json?
  delaiValiditeJours Int           @default(30)
  dateCreation       DateTime      @default(now())

  souscriptions Souscription[]

  @@map("produits")
}

model Souscription {
  id             String             @id @default(cuid())
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id])
  produitId      String
  produit        Produit            @relation(fields: [produitId], references: [id])
  programmeId    String
  programme      Programme          @relation(fields: [programmeId], references: [id])
  dateCreation   DateTime           @default(now())
  statut         StatutSouscription @default(EN_ATTENTE)
  numRecu        String             @unique
  dateExpiration DateTime

  paiements     Paiement[]
  notifications Notification[]

  @@map("souscriptions")
}

model Paiement {
  id                 String         @id @default(cuid())
  souscriptionId     String
  souscription       Souscription   @relation(fields: [souscriptionId], references: [id])
  montant            Float
  modeReglement      ModeReglement
  referenceQuittance String?
  agentValideurId    String?
  agentValideur      UtilisateurBO? @relation(fields: [agentValideurId], references: [id])
  dateValidation     DateTime       @default(now())
  pieceJointeRecu    String?

  @@map("paiements")
}

model UtilisateurBO {
  id                 String            @id @default(cuid())
  nom                String
  email              String            @unique
  motDePasse         String
  role               RoleBO
  programmesAssignes String[]
  statut             StatutUtilisateur @default(ACTIF)
  twoFactorSecret    String?
  twoFactorEnabled   Boolean           @default(false)
  dateCreation       DateTime          @default(now())

  paiementsValides Paiement[]
  auditLogs        AuditLog[]

  @@map("utilisateurs_bo")
}

model Notification {
  id             String            @id @default(cuid())
  souscriptionId String
  souscription   Souscription      @relation(fields: [souscriptionId], references: [id])
  type           TypeNotification
  canal          CanalNotification
  contenu        String
  statutEnvoi    StatutEnvoi       @default(EN_ATTENTE)
  dateEnvoi      DateTime?
  dateCreation   DateTime          @default(now())

  @@map("notifications")
}

model AuditLog {
  id            String         @id @default(cuid())
  utilisateurId String?
  utilisateur   UtilisateurBO? @relation(fields: [utilisateurId], references: [id])
  action        String
  details       Json?
  ip            String?
  dateAction    DateTime       @default(now())

  @@map("audit_logs")
}
